# Maintainer: Weird Brains LLC <m3talsmith@gmail.com>
# Binary package: installs the prebuilt static (musl) grindvakt binary attached to the GitHub
# release. No Rust needed. The release tarball is not code-signed; this package is likewise
# unsigned. Per release: bump pkgver and the sha256sums (tarball from the release's SHA256SUMS,
# LICENSE and README.md of the tag), then `python3 scripts/weirdnet_release.py taur-srcinfo
# packaging/arch/grindvakt-bin`.
pkgname=grindvakt-bin
pkgver=1.3.0
pkgrel=1
pkgdesc="User-mode dynamic DNS updater for DNSimple and DigitalOcean (secure local vault; systemd --user), prebuilt"
arch=('x86_64')
url="https://github.com/WeirdBrains/grindvakt"
license=('BSD-3-Clause')
provides=('grindvakt')
conflicts=('grindvakt')
options=('!strip' '!debug')
source=("grindvakt-$pkgver-x86_64-musl.tar.gz::$url/releases/download/v$pkgver/grindvakt-x86_64-musl.tar.gz"
        "LICENSE-$pkgver::$url/raw/v$pkgver/LICENSE"
        "README-$pkgver.md::$url/raw/v$pkgver/README.md")
sha256sums=('aaa7c379dc443113ee94f8e42e35255fafa400ac523f2d3928ec4dc89707de95'
            '98122f08aae8ece54b31e2f5a574a7c59392a90233e4d3156df122045149f13b'
            '915562052e40117b86da71d104c1d019dfb1d38d83a559d8afe12577c68861b6')
noextract=("grindvakt-$pkgver-x86_64-musl.tar.gz")

package() {
  bsdtar -xf "$srcdir/grindvakt-$pkgver-x86_64-musl.tar.gz" -C "$srcdir" grindvakt
  install -Dm755 "$srcdir/grindvakt" "$pkgdir/usr/bin/grindvakt"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README-$pkgver.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
